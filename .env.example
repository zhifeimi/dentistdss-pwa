# Local development defaults. Vercel injects the production value; previews
# should use a staging API or remain empty to prevent production data access.
VITE_API_HOST=http://localhost
VITE_API_PORT=8080
VITE_API_ROOT_PATH=
VITE_API_AUTH_PATH=/auth
VITE_API_OAUTH_PATH=/oauth
VITE_API_GENAI_PATH=/genai

# These values are embedded in the browser bundle. Restrict the Maps key by
# hostname/API in Google Cloud; never put a server-side secret in a VITE_* var.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
