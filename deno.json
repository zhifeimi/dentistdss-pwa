{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "none",
  "minimumDependencyAge": "P3D",
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "unstable": ["sloppy-imports"],
  "imports": {
    "@/": "./src/"
  },
  "exclude": ["build/", "coverage/", "node_modules/", "playwright-report/", "test-results/"],
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vite --host 0.0.0.0",
    "start": "deno task dev",
    "build": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vite build",
    "preview": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vite preview --host 0.0.0.0",
    "test": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vitest --run",
    "test:watch": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vitest",
    "test:unit": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vitest --run tests/unit",
    "test:integration": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vitest --run tests/integration",
    "test:components": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vitest --run tests/components",
    "test:utils": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vitest --run tests/utils",
    "test:coverage": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts vitest --run --coverage",
    "test:e2e": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts playwright test tests/e2e",
    "test:e2e:ui": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts playwright test tests/e2e --ui",
    "test:e2e:install": "deno run --allow-read --allow-write --allow-run scripts/deno-tool.ts playwright install",
    "typecheck": "deno check src/index.tsx vite.config.ts playwright.config.ts scripts/deno-tool.ts",
    "lint": "deno lint src/ tests/ scripts/ vite.config.ts playwright.config.ts",
    "fmt": "deno fmt deno.json package.json scripts/deno-tool.ts vite.config.ts playwright.config.ts src/serviceWorkerRegistration.ts public/service-worker.js public/manifest.webmanifest",
    "fmt:check": "deno fmt --check deno.json package.json scripts/deno-tool.ts vite.config.ts playwright.config.ts src/serviceWorkerRegistration.ts public/service-worker.js public/manifest.webmanifest",
    "audit": "deno audit --level=low",
    "check": "deno task fmt:check && deno task lint && deno task typecheck"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": [
        "no-empty-interface",
        "no-explicit-any",
        "no-sloppy-imports",
        "no-unused-vars",
        "no-window",
        "no-window-prefix",
        "require-await"
      ]
    }
  }
}
